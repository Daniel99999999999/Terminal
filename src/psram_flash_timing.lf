# Keep only the PSRAM command path and its GPIO reservation dependency usable
# until flash CS timing has been restored by the early wrapper.
[mapping:retro_psram_flash_timing]
archive: libesp_psram.a
entries:
    if IDF_TARGET_ESP32 = y && SPIRAM = y:
        esp_psram_impl_quad (noflash)

[mapping:retro_psram_flash_gpio]
archive: libesp_hw_support.a
entries:
    if IDF_TARGET_ESP32 = y && SPIRAM = y:
        esp_gpio_reserve (noflash)

[mapping:retro_psram_flash_gpio_tables]
archive: libsoc.a
entries:
    if IDF_TARGET_ESP32 = y && SPIRAM = y:
        gpio_periph (noflash)
