# ESP32-WROVER: 4MB Flash and 4MB Quad PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Native BT/Wi-Fi are excluded by MINIMAL_BUILD and explicit dependencies.
# HC-05 options: src/Kconfig.projbuild. TFT profiles: src/display_profile.h.

# Zbit 5E4016: Quad IO also disables HOLD on data lines shared with PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
