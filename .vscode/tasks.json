{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PIO: Build (esp32dev)",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "-e",
        "esp32dev"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PIO: Upload",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "-e",
        "esp32dev",
        "-t",
        "upload"
      ],
      "problemMatcher": []
    },
    {
      "label": "PIO: Monitor (115200)",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "device",
        "monitor",
        "-b",
        "115200"
      ],
      "problemMatcher": []
    },
    {
      "label": "PIO: Menuconfig",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "-e",
        "esp32dev",
        "-t",
        "menuconfig"
      ],
      "problemMatcher": []
    },
    {
      "label": "PIO: Build SPI TFT + XPT2046",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "esp32dev_spi"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "PIO: Upload SPI TFT (internal RAM diagnostic)",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "esp32dev_internal", "-t", "upload", "--upload-port", "COM5"],
      "problemMatcher": []
    },
    {
      "label": "PIO: Upload SPI TFT + XPT2046",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "esp32dev_spi", "-t", "upload"],
      "problemMatcher": []
    },
    {
      "label": "PIO: Build I80 TFT",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "esp32dev_i80"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "PIO: Upload I80 TFT",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-e", "esp32dev_i80", "-t", "upload"],
      "problemMatcher": []
    },
    {
      "label": "BT reference: Build",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-d", "${workspaceFolder}/diagnostics/esp_idf_spp_acceptor", "-e", "esp32dev"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "BT reference: Upload",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": ["run", "-d", "${workspaceFolder}/diagnostics/esp_idf_spp_acceptor", "-e", "esp32dev", "-t", "upload"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
